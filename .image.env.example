# Copy this file to .image.env, then uncomment and adjust only the values you need.
# build_image.sh loads .image.env with Bash syntax before resolving its defaults.
# Positional hostname, dev-user, and WiFi arguments still take precedence over these values.
# Keep passwords and local paths in .image.env, never in this example.

# Image mode and development-access defaults.
# BUILD_MODE=dev
# IMAGE_HOSTNAME=droneos
# DEV_USER_NAME=admin
# DEV_USER_PASSWORD='set-a-strong-unique-password'
# WIFI_SSID=droneos
# WIFI_PASSWORD='set-a-private-wpa-passphrase'
# WIFI_COUNTRY=US
# DEV_PROJECT_DIR='/home/admin/droneOS'

# Alpine image source. Set at most one of ALPINE_TARBALL, ALPINE_TARBALL_URL, or ALPINE_VERSION.
# ALPINE_MIRROR='https://dl-cdn.alpinelinux.org/alpine'
# ALPINE_BRANCH=latest-stable
# ALPINE_ARCH=aarch64
# ALPINE_VERSION=3.20.3
# ALPINE_TARBALL='/absolute/path/to/alpine-rpi.tar.gz'
# ALPINE_TARBALL_URL='https://example.invalid/alpine-rpi.tar.gz'
# ALPINE_CACHE_DIR='/absolute/path/to/alpine-cache'
# APK_FETCH_CONTAINER_IMAGE=alpine:latest

# Local image-build paths and architecture override.
# BUILD_DIR='/absolute/path/to/build'
# MOUNT_BASE=/tmp/droneos_mnt
# GOARM=7

# Boot and device settings. DISABLE_WIFI and ENABLE_UART_CONSOLE default by BUILD_MODE.
# DISABLE_WIFI=0
# DISABLE_BLUETOOTH=1
# ENABLE_UART_CONSOLE=1
# UART_CONSOLE_TTY=ttyAMA0
# UART_CONSOLE_EXTRA_TTYS=ttyS0
# UART_CONSOLE_BAUD=115200

# These must remain at their currently supported values.
# SKIP_KERNEL_BUILD=1
# INSTALL_PISUGAR=0
