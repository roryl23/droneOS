# Copy to .drone.env to configure the drone runtime locally.
# Command-line flags take precedence over values in this file.
DRONEOS_CONFIG_FILE=configs/config.yaml
# Set to 1 or true only for specialized profiling or tuning.
DRONEOS_DISABLE_GC=0

# Realtime control-thread scheduling. Generated realtime images export these
# defaults from OpenRC; local and source-sync runs remain disabled unless enabled.
DRONEOS_RT_ENABLE=0
DRONEOS_RT_STRICT=0
DRONEOS_RT_POLICY=fifo
DRONEOS_RT_PRIORITY=20
DRONEOS_RT_CPU=-1
# MCL_CURRENT|MCL_FUTURE is process-wide and can fail when RLIMIT_MEMLOCK is low.
DRONEOS_RT_MLOCK=0
